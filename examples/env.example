PLUTIO_CLIENT_ID=your-client-id
PLUTIO_CLIENT_SECRET=your-client-secret
PLUTIO_BUSINESS=your-business-slug
# PLUTIO_API_BASE=https://api.plutio.com/v1.11
# PLUTIO_USER_AGENT=plutio-mcp/0.1.0

# --- Access control (required for any public deployment) ---
# Static API keys, comma separated, min 24 chars. Send as "Authorization: Bearer <key>" or "x-api-key: <key>".
# Generate with: openssl rand -hex 32
MCP_API_KEYS=
# Passcode shown on the OAuth consent page (used by claude.ai connectors). If unset, OAuth sign-in is disabled.
MCP_AUTH_PASSCODE=
# MCP_ALLOW_OPEN_AUTHORIZE=false   # only set true on a private network
